<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the app's windows to PNG files without a display (design checks on any OS). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SalatTime\SalatTime.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>
</Project>
