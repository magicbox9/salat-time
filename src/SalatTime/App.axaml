<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SalatTime.App"
             RequestedThemeVariant="Default"
             Name="Salat Time">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SalatTime/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
          <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
          <SolidColorBrush x:Key="TextTertiary" Color="#73000000" />
          <SolidColorBrush x:Key="CardBrush" Color="#0B000000" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="RaisedCardBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
          <SolidColorBrush x:Key="PressedBrush" Color="#14000000" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7F7" />
          <SolidColorBrush x:Key="SurfaceTintBrush" Color="#CCF7F7F7" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#00000000" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FC42B1C" />
          <SolidColorBrush x:Key="ChipBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="AccentBrush" Color="#166534" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#24166534" />
          <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
          <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF" />
          <SolidColorBrush x:Key="CardBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="RaisedCardBrush" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="PressedBrush" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
          <SolidColorBrush x:Key="SurfaceTintBrush" Color="#D9202020" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#00000000" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#33FF99A4" />
          <SolidColorBrush x:Key="ChipBrush" Color="#474747" />
          <SolidColorBrush x:Key="AccentBrush" Color="#66DB8C" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#3866DB8C" />
          <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B2615" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="HeaderBrush" Color="#166534" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SalatTime/Styles.axaml" />
  </Application.Styles>
</Application>
