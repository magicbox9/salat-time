* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore

# Verified Qur'an assets: keep every byte exactly as published (no line-ending changes).
resources/quran/** -text
public/fonts/quran/** -text
resources/content/** -text

# The prayer-time method package: data and test vectors pinned by SHA-256 in MANIFEST.json.
resources/prayer-method/*.json -text
tests/Fixtures/prayer-method/** -text
