APP_NAME="Salat Time"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8095

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=salat
# The app connects as this NON-superuser role (created by docker/postgres/init).
DB_USERNAME=salat_app
DB_PASSWORD=salat_app_dev_password
# Superuser, used only by the db container to initialise the volume.
DB_ADMIN_USERNAME=salat
DB_ADMIN_PASSWORD=salat_dev_password

# Host ports (docker compose)
WEB_PORT=8095
DB_PORT_HOST=5434
MAIL_UI_PORT=8026
ADMINER_PORT=8086

# Research data mounted read-only at /data/studies (php artisan mosques:import)
STUDIES_PATH="../Prayer Times Study"

# Off by default: fetching mosque pages from mawaqit.net. Check Mawaqit's terms
# (its API is private) before enabling anything that talks to it.
MAWAQIT_SYNC_ENABLED=false

# Donations by PayPal go straight to each mosque's verified PayPal account.
# Create an app at developer.paypal.com (sandbox first) and register the webhook
# https://<host>/webhooks/paypal (PAYMENT.CAPTURE.* events).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BRAND_NAME="Salat Time"
PAYPAL_SOFT_DESCRIPTOR=

# One-click sign-in as the DevSeeder test accounts (only works with APP_ENV=local).
DEV_LOGIN=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@salat-time.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
